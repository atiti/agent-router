+fn normalize_prompt_for_provider(input: &mut Vec<ResponseItem>, provider: &ModelProviderInfo) {
+    match provider.tool_compatibility {
+        Some(ToolCompatibility::FunctionsAndApplyPatch) => {
+            let unsupported_custom_calls = input
+                .iter()
+                .filter_map(|item| match item {
+                    ResponseItem::CustomToolCall { call_id, name, .. } if name != "apply_patch" => {
+                        Some(call_id.clone())
+                    }
+                    _ => None,
+                })
+                .collect::<HashSet<_>>();
+            input.retain(|item| match item {
+                ResponseItem::Reasoning { .. }
+                | ResponseItem::AdditionalTools { .. }
+                | ResponseItem::LocalShellCall { .. }
+                | ResponseItem::ToolSearchCall { .. }
+                | ResponseItem::ToolSearchOutput { .. }
+                | ResponseItem::WebSearchCall { .. }
+                | ResponseItem::ImageGenerationCall { .. }
+                | ResponseItem::Compaction { .. }
+                | ResponseItem::ContextCompaction { .. } => false,
+                ResponseItem::CustomToolCall { name, .. } => name == "apply_patch",
+                ResponseItem::CustomToolCallOutput { call_id, .. } => {
+                    !unsupported_custom_calls.contains(call_id)
+                }
+                _ => true,
+            });
+            // Response item IDs are provider-owned and are not portable across
+            // OpenAI-compatible implementations. Call IDs remain intact so
+            // function/custom output pairing is preserved.
+            for item in input.iter_mut() {
+                item.set_id(None);
+            }
+        }
+        None if provider.is_openai() => {
+            input.retain(|item| match item {
+                // OpenAI reasoning items have an `rs_` ID and no plaintext
+                // reasoning content. Third-party Responses implementations may
+                // return plaintext here, which OpenAI rejects when replayed.
+                ResponseItem::Reasoning { id, content, .. } => {
+                    id.as_ref().is_some_and(|id| id.starts_with("rs_"))
+                        && content.as_ref().is_none_or(Vec::is_empty)
+                }
+                _ => true,
+            });
+            for item in input.iter_mut() {
+                if item.id().is_some_and(|id| !id.is_prefixed()) {
+                    item.set_id(None);
+                }
+            }
+        }
+        None => {
+            // OpenAI-compatible API providers can support the same tool wire
+            // format while belonging to a different encryption authority.
+            // Reasoning and compaction ciphertext, encrypted function args,
+            // and response item IDs are bound to the organization/deployment
+            // that produced them and must not cross that boundary.
+            input.retain(|item| {
+                !matches!(
+                    item,
+                    ResponseItem::Reasoning { .. }
+                        | ResponseItem::Compaction { .. }
+                        | ResponseItem::ContextCompaction { .. }
+                )
+            });
+            for item in input.iter_mut() {
+                if let ResponseItem::FunctionCall {
+                    encrypted_function_args,
+                    ..
+                } = item
+                {
+                    *encrypted_function_args = None;
+                }
+                item.set_id(None);
+            }
+        }
+    }
+}
