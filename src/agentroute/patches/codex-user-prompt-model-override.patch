+pub(crate) fn model_info_for_provider_compatibility(
+    admitted: &ModelInfo,
+    destination: &ModelInfo,
+    compatibility: ToolCompatibility,
+) -> ModelInfo {
+    // Start with the admitted metadata so a provider switch cannot change local
+    // approval, Guardian, reviewer, or Node REPL authority. Only model identity
+    // and wire-level tool capabilities are provider-specific here.
+    let mut model_info = admitted.clone();
+    model_info.slug.clone_from(&destination.slug);
+    model_info.display_name.clone_from(&destination.display_name);
+    model_info.description.clone_from(&destination.description);
+    match compatibility {
+        ToolCompatibility::FunctionsAndApplyPatch => {
+            model_info.tool_mode = Some(ToolMode::Direct);
+            model_info.apply_patch_tool_type = Some(ApplyPatchToolType::Freeform);
+            model_info.supports_search_tool = false;
+            model_info.use_responses_lite = false;
+            model_info.experimental_supported_tools.clear();
+        }
+    }
+    model_info.used_fallback_model_metadata = false;
+    model_info
+}
